{
  "name": "legacylens",
  "version": "1.0.0",
  "description": "AI-powered legacy code intelligence platform — Onboard to any codebase in hours, not weeks",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client": "vite",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:worker": "tsx watch src/workers/index.ts",
    "build": "vite build && tsc -p tsconfig.server.json",
    "vercel-build": "vite build",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "start:worker": "node dist/workers/index.js",
    "type-check": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "lint": "eslint src/ --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.986.0",
    "@clerk/backend": "^2.30.1",
    "@clerk/clerk-react": "^5.60.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fastify/cors": "^10.0.2",
    "@fastify/multipart": "^9.4.0",
    "@fastify/rate-limit": "^10.2.1",
    "@fastify/static": "^9.0.0",
    "@fastify/websocket": "^11.0.2",
    "@google-cloud/storage": "^7.19.0",
    "@prisma/client": "^6.3.0",
    "@tanstack/react-query": "^5.66.0",
    "@trpc/client": "^11.0.0",
    "@trpc/react-query": "^11.0.0",
    "@trpc/server": "^11.0.0",
    "bullmq": "^5.34.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cohere-ai": "^7.16.0",
    "d3": "^7.9.0",
    "dotenv": "^17.2.4",
    "fastify": "^5.2.1",
    "firebase-admin": "^13.6.1",
    "googleapis": "^144.0.0",
    "groq-sdk": "^0.9.0",
    "ioredis": "^5.4.2",
    "lucide-react": "^0.474.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^9.0.3",
    "react-router-dom": "^7.1.5",
    "react-syntax-highlighter": "^15.6.6",
    "recharts": "^2.15.1",
    "simple-git": "^3.27.0",
    "stripe": "^17.6.0",
    "superjson": "^2.2.2",
    "tailwind-merge": "^3.0.1",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^11.0.5",
    "zod": "^3.24.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@vercel/node": "^5.0.0",
    "@eslint/js": "^9.19.0",
    "@tailwindcss/typography": "^0.5.16",
    "@types/d3": "^7.4.3",
    "@types/node": "^22.12.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react-swc": "^3.7.2",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "eslint": "^9.19.0",
    "postcss": "^8.5.1",
    "prettier": "^3.4.2",
    "prisma": "^6.3.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
