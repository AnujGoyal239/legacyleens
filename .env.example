# =============================================================
# LegacyLens Environment Variables
# Copy this file to .env and fill in your values
# =============================================================

# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Redis (metadata only: BullMQ job queue, rate limits, sessions)
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_URL="redis://localhost:6379"

# Clerk (Auth)
# Backend
CLERK_SECRET_KEY="sk_test_..."
# Frontend (Vite)
VITE_CLERK_PUBLISHABLE_KEY="pk_test_dHJ1c3RpbmctZG9nZmlzaC0xMS5jbGVyay5hY2NvdW50cy5kZXYk"

# GitHub (for repo access; OAuth sign-in is via Clerk)
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"

# Groq API (LLM + Transcription)
GROQ_API_KEY="your-groq-api-key"

# Cohere API (Embeddings + Reranking)
COHERE_API_KEY="your-cohere-api-key"

# Backblaze B2 (File Storage)
B2_KEY_ID="your-b2-key-id"
B2_APPLICATION_KEY="your-b2-application-key"
B2_BUCKET_NAME="legacylens-meetings"

# Stripe (Payments)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_PRO_PRICE_ID="price_..."
STRIPE_TEAM_PRICE_ID="price_..."

# Sentry (Error Tracking)
SENTRY_DSN=""

# App Configuration
NODE_ENV="development"
PORT="3000"
FRONTEND_URL="http://localhost:5173"
API_URL="http://localhost:3000"

# Logging
LOG_LEVEL="info"
