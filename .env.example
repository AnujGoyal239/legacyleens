# =============================================================
# LegacyLens — Environment Variables Template
# Copy to .env and fill in values. See Docs/ENV_SETUP.md for how to get each.
# =============================================================

# -----------------------------------------------------------------------------
# Required for core app
# -----------------------------------------------------------------------------

# Database (PostgreSQL — e.g. Neon, Supabase, or local)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Redis (BullMQ jobs, rate limits, sessions)
REDIS_URL="redis://localhost:6379"

# Clerk (Authentication)
CLERK_SECRET_KEY="sk_test_..."
VITE_CLERK_PUBLISHABLE_KEY="pk_test_..."

# -----------------------------------------------------------------------------
# Required for repo indexing, Q&A, embeddings
# -----------------------------------------------------------------------------

# Cohere (embeddings + rerank for code search and Q&A)
COHERE_API_KEY=""

# -----------------------------------------------------------------------------
# Required for AI features (LLM, docs, refactor, fix-it)
# -----------------------------------------------------------------------------

# Groq (LLM: Q&A, commit summaries, LLD/HLD/System Design, refactor, fix-it)
GROQ_API_KEY=""

# -----------------------------------------------------------------------------
# Required for meetings (uploaded/live recording storage)
# -----------------------------------------------------------------------------

# File Storage — choose one: gcs (Google Cloud Storage) or b2 (Backblaze B2)
STORAGE_PROVIDER="gcs"

# Google Cloud Storage (if STORAGE_PROVIDER=gcs)
GCS_BUCKET=""
GCP_PROJECT_ID=""
# GCS_KEY_FILE=""  # Path to service account key JSON (not needed on Cloud Run)

# Backblaze B2 (if STORAGE_PROVIDER=b2)
B2_KEY_ID=""
B2_APPLICATION_KEY=""
B2_BUCKET_NAME=""
B2_BUCKET_ID=""

# -----------------------------------------------------------------------------
# Optional — Google Meet / Calendar integration
# Create OAuth 2.0 credentials at https://console.cloud.google.com/apis/credentials
# Enable Google Calendar API in your GCP project
# -----------------------------------------------------------------------------

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3001/api/google/callback"

# -----------------------------------------------------------------------------
# Required for GitHub repo access (clone, file fetch, optional OAuth)
# -----------------------------------------------------------------------------

# GitHub (OAuth sign-in via Clerk; repo clone/fetch uses PAT per project or these)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# -----------------------------------------------------------------------------
# Optional — App server & URLs
# -----------------------------------------------------------------------------

NODE_ENV="development"
PORT="3000"
HOST="0.0.0.0"
FRONTEND_URL="http://localhost:5173"
API_URL="http://localhost:3000"
# Frontend tRPC base URL (must match API_URL in dev)
VITE_API_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# Optional — Payments (Stripe)
# -----------------------------------------------------------------------------

STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_PRO_PRICE_ID=""
STRIPE_TEAM_PRICE_ID=""

# -----------------------------------------------------------------------------
# Optional — Observability & temp dir
# -----------------------------------------------------------------------------

LOG_LEVEL="info"
SENTRY_DSN=""
# Temp dir for repo clone (default: /tmp on Unix, %TEMP% on Windows)
# TEMP="/tmp"

# -----------------------------------------------------------------------------
# GCP Deployment (Cloud Run)
# These are used by cloudbuild.yaml and GitHub Actions, not the app itself.
# Set secrets in Cloud Run service environment or Secret Manager.
# -----------------------------------------------------------------------------
# GCP_PROJECT_ID is set above (shared with GCS)
# GCP_REGION="us-central1"
